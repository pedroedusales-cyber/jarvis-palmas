# JARVIS Configuration
JARVIS_NAME=JARVIS
JARVIS_VOICE=female
JARVIS_LANGUAGE=pt-BR
DEBUG_MODE=False

# Audio Configuration
AUDIO_DEVICE_INDEX=0
SAMPLE_RATE=44100
CHUNK_SIZE=2048
CLAP_THRESHOLD=0.7

# OpenAI API (Optional)
OPENAI_API_KEY=your_key_here
OPENAI_MODEL=gpt-4

# Smart Home Integration
SMART_HOME_ENABLED=False
HOME_ASSISTANT_URL=http://localhost:8123
HOME_ASSISTANT_TOKEN=your_token_here

# Spotify Integration (Optional)
SPOTIFY_CLIENT_ID=your_client_id
SPOTIFY_CLIENT_SECRET=your_client_secret
SPOTIFY_REDIRECT_URI=http://localhost:8888/callback

# Security
AUTH_ENABLED=True
AUTH_PATTERN=12345

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/jarvis.log
LOG_MAX_SIZE=10MB

# Database (Optional)
DATABASE_URL=sqlite:///data/jarvis.db

# API Server (Optional)
API_HOST=0.0.0.0
API_PORT=5000
API_DEBUG=False

# Timezone
TIMEZONE=America/Sao_Paulo

# Voice Settings
VOICE_SPEED=150
VOICE_VOLUME=0.8
TEXT_TO_SPEECH_ENGINE=pyttsx3
